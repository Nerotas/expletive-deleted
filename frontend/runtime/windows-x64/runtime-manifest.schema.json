{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expletive Deleted audited Windows private Python manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "python", "pip", "files", "licenses"],
  "properties": {
    "schema_version": { "const": 2 },
    "platform": { "const": "win32-x64" },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "license"],
      "properties": {
        "path": { "const": "python/python.exe" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "const": "PSF-2.0" }
      }
    },
    "pip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "license"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "license": { "const": "MIT" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "spdx"],
        "properties": {
          "path": { "type": "string", "pattern": "^LICENSES/" },
          "spdx": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
