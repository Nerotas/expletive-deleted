{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue83-inventory-v1.schema.json",
  "title": "Issue 83 generated shipped-file inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "platform", "input_lock_sha256", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "$ref": "#/$defs/id" },
    "platform": { "const": "win32-x64" },
    "input_lock_sha256": { "$ref": "#/$defs/sha256" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "path", "sha256", "purpose", "owner_component_id", "transformation_id", "derived_from"],
      "properties": {
        "scope": { "enum": ["installer", "source"] },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "enum": ["payload", "notice", "license", "metadata", "source", "patch", "build-script"] },
        "owner_component_id": { "$ref": "#/$defs/id" },
        "transformation_id": { "$ref": "#/$defs/id" },
        "derived_from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
