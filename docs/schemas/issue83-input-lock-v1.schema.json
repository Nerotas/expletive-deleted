{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue83-input-lock-v1.schema.json",
  "title": "Issue 83 approved Windows input lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "release_id", "platform", "components", "transformations"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "approved" },
    "release_id": { "$ref": "#/$defs/id" },
    "platform": { "const": "win32-x64" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "transformations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transformation" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "url", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["payload", "source", "patch", "build-script", "notice", "license"] },
        "name": { "type": "string", "pattern": "^[^./\\\\:][^/\\\\:]*$" },
        "url": { "type": "string", "pattern": "^https://[^/]+/.+" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "origin_artifact_id": { "$ref": "#/$defs/id" },
        "archive_member": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "origin_artifact_id": ["archive_member"],
        "archive_member": ["origin_artifact_id"]
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license_expression", "artifacts", "source_artifact_ids", "notice_artifact_ids", "license_artifact_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "license_expression": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "source_artifact_ids": { "$ref": "#/$defs/ids" },
        "notice_artifact_ids": { "$ref": "#/$defs/ids" },
        "license_artifact_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input_artifact_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["copy", "extract", "install", "build", "generate"] },
        "input_artifact_ids": { "$ref": "#/$defs/ids" }
      }
    }
  }
}
